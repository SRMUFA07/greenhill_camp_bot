# Telegram Bot Configuration
# Получите токен у @BotFather в Telegram
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=greenhill_camp_bot

# Telegram ID администратора (числовой ID, куда будут приходить уведомления о новых заявках)
# Узнать свой ID можно в Telegram-боте @userinfobot
ADMIN_TG_ID=123456789

# Database Configuration (PostgreSQL)
# Для Docker Compose логин/пароль по умолчанию:
POSTGRES_DB=greenhill_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Параметры подключения для локального запуска без Docker (опционально)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/greenhill_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
